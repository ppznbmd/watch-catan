# Copy to .env and fill in. .env is gitignored; this file is the template.
# An exported variable always wins over what is written here.

# Default provider. https://platform.openai.com -> API keys
OPENAI_API_KEY=

# https://platform.deepseek.com -> API keys
DEEPSEEK_API_KEY=

# Only needed for claude-* seats.
ANTHROPIC_API_KEY=

# Change the default model for every run without touching the command line.
# --model and --seat still override it.
# WATCH_CATAN_MODEL=gpt-5.6-luna
